# superpowers/sdd/* — plan execution workspaces (git-ignored scratch)
/.superpowers/

# Planning scratch from opencode/Claude worktrees
.planning/

# Playwright MCP server logs / snapshots from local browser testing
.playwright-mcp/

# Maven build outputs — never commit
target/

# Maven site reports (published to GitHub Pages by reports.yml, never committed)
target/site/
site/frontend/public/reports/
site/frontend/public/playwright-report/

# MegaLinter output. APPLY_FIXES is disabled (see .mega-linter.yml) but the
# directory is still created on every run and must never be committed.
megalinter-reports/

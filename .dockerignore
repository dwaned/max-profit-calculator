# Exclude heavy / irrelevant directories from the Docker build context.
# The app Dockerfile needs pom.xml + src and the frontend Dockerfile needs
# site/frontend/, so everything else just wastes upload time and disk.

# Build outputs
target/
**/target/
**/dist/
**/build/

# Dependencies
**/node_modules/

# VCS / metadata
.git/
.gitignore
.gitattributes

# IDE / OS noise
.idea/
.vscode/
.DS_Store

# Docs / planning / local artifacts
.planning/
.playwright-mcp/
.superpowers/
megalinter-reports/
*.md
!site/frontend/README.md

# CI / infra (Render uses the Dockerfile directly, doesn't need these)
.github/

# Test outputs already covered by target/
**/surefire-reports/
**/cucumber-report/

# Generated reports are published to GitHub Pages, never baked into images
site/frontend/public/reports/

# Pact files are copied into target/classes at build time
site/frontend/pacts/

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "max-profit-lab",
  "compatibility_date": "2026-10-01",
  // Static React build only; the API stays on Render. HashRouter keeps routes
  // under "/", and unknown paths fall back to index.html like nginx.conf.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview` (preview build per PR). Empty means: same as production.
  "previews": {}
}

{
  "consumer": {
    "name": "frontend"
  },
  "interactions": [
    {
      "description": "a request to calculate max profit",
      "request": {
        "body": {
          "buyPrices": [
            5,
            5,
            10
          ],
          "companyNames": [
            "Acme Corp",
            "Globex Inc",
            "Initech"
          ],
          "savings": 10,
          "sellPrices": [
            15,
            10,
            35
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/calculate"
      },
      "response": {
        "body": {
          "companyNames": [
            "Initech"
          ],
          "indices": [
            2
          ],
          "maxProfit": 25,
          "remainingSavings": 0,
          "savingsUsed": 10
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.companyNames": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.companyNames[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.indices": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.indices[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.maxProfit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.remainingSavings": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.savingsUsed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request with invalid savings",
      "request": {
        "body": {
          "buyPrices": [
            5,
            5,
            10
          ],
          "savings": -10,
          "sellPrices": [
            15,
            10,
            35
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/calculate"
      },
      "response": {
        "body": {
          "message": "Invalid input: Savings must be at least 1"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "max-profit-calculator-backend"
  }
}
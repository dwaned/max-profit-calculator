{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:pact": "vitest run --config vitest.pact.config.js",
    "test:pact:ci": "vitest run --config vitest.pact.config.js",
    "test:ui": "playwright test --config=playwright.config.js",
    "test:ui:report": "playwright test --config=playwright.config.js --reporter=html"
  },
  "dependencies": {
    "framer-motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.1.18",
    "vite": "^8.0.8",
    "vitest": "^5.0.2"
  }
}
